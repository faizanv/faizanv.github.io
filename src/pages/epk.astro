---
import Layout from "../layouts/Layout.astro";

const mixes = [
  {
    title: "Faizan Puts You On, Vol. 2",
    url: "https://soundcloud.com/faizanv/faizan-puts-you-on-vol-2",
  },
  {
    title: "Faizan Puts You On, Vol. 1 — UKG x Desi Bass x House Mix",
    url: "https://soundcloud.com/faizanv/faizan-puts-you-on-vol-1-ukg-x-desi-bass-x-house-mix",
  },
];

const soundcloudEmbedUrl = (url: string) =>
  `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%2338bdf8&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=false`;

const venues = [
  {
    name: "Mood Ring",
    location: "Ridgewood, Brooklyn",
    role: "Peak Slot",
  },
  {
    name: "abunDANCE × Daytimers NYC",
    location: "Honey's / Bushwick, NY",
    role: "Curator / Resident",
  },
  {
    name: "Eris Evolution",
    location: "Williamsburg, Brooklyn",
    role: "Direct Support",
  },
  {
    name: "Bossa Nova Civic Club & Jupiter Disco",
    location: "Bushwick, Brooklyn",
    role: "Guest Sets",
  },
];

const bio =
  "Brooklyn DJ and selector weaving South Asian percussion into UK garage, broken beat, and bass-led club music.";

---

<Layout
  title="faizan — Electronic Press Kit"
  ogTitle="faizan — Electronic Press Kit"
  ogDescription="Press kit for faizan, a Brooklyn-based DJ and selector."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="/" aria-label="Faizan home">faizan</a>
      <nav class="primary-nav" aria-label="Page sections">
        <a href="#bio">About</a>
        <a href="#venues">Gigs</a>
        <a href="#mixes">Mixes</a>
        <a href="#press">Press</a>
      </nav>
    </div>
  </header>

  <main id="main" class="page-content">
    <section id="bio" class="section-rule">
      <div class="hero">
        <div class="hero-copy">
          <p class="eyebrow">DJ/Producer · BROOKLYN, NY</p>
          <h1>faizan</h1>
          <p class="hero-subtitle">South Asian percussion, UK garage, and bass-led club music.</p>
          <div class="genres" aria-label="Genres">
            <span>South Asian Club</span>
            <span>UK Garage</span>
            <span>Broken Beat</span>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#mixes">Listen to Mixes</a>
            <a class="button button-muted" href="mailto:bookings@faizan.fun">Book faizan</a>
          </div>
        </div>

        <figure class="photo-frame hero-photo">
          <img
            src="/DJ_header.webp"
            alt="faizan performing at a DJ mixer"
            width="1000"
            height="1334"
          />
        </figure>
      </div>

      <div class="bio-copy">
        <h2>About</h2>
        <p>{bio}</p>
      </div>
    </section>

    <section id="venues" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / Experience</p>
          <h2>Venues &amp; Gigs</h2>
        </div>
      </div>
      <div class="venue-grid">
        {venues.map((venue) => (
          <article class="venue-card">
            <h3>{venue.name}</h3>
            <p class="venue-meta">{venue.location} · {venue.role}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="mixes" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / Listen</p>
          <h2>Featured Mixes</h2>
        </div>
      </div>
      <div class="mix-grid">
        {mixes.map((mix) => (
          <article class="mix-card">
            <h3>{mix.title}</h3>
            <iframe
              class="soundcloud-embed"
              src={soundcloudEmbedUrl(mix.url)}
              title={`SoundCloud player for ${mix.title}`}
              width="100%"
              height="166"
              scrolling="no"
              frameborder="no"
              allow="autoplay"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </article>
        ))}
      </div>
      <p class="also">More on SoundCloud: <a href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">faizanv ↗</a></p>
    </section>

    <section id="press" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / Press</p>
          <h2>Photos &amp; Wordmark</h2>
        </div>
      </div>
      <div class="press-grid">
        <article class="press-card">
          <div class="press-image photo-frame">
            <img src="/headshot.png" alt="Portrait of faizan for press use" loading="lazy" />
          </div>
          <div class="press-card-footer">
            <h3>Press portrait</h3>
            <a class="button button-small button-muted" href="mailto:bookings@faizan.fun?subject=Press%20photo%20request">Request photo</a>
          </div>
        </article>
        <article class="press-card wordmark-card">
          <div class="wordmark-preview">
            <span class="large-wordmark">faizan</span>
          </div>
          <div class="press-card-footer">
            <h3>Wordmark</h3>
            <button class="button button-small button-muted download-wordmark" type="button">Download SVG</button>
          </div>
        </article>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <span>Brooklyn, NY</span>
    <nav aria-label="Contact and profiles">
      <a href="mailto:bookings@faizan.fun">bookings@faizan.fun</a>
      <a href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">SoundCloud ↗</a>
      <a href="https://ra.co" target="_blank" rel="noopener noreferrer">RA ↗</a>
    </nav>
  </footer>
</Layout>

<script>
  function downloadFile(filename: string, content: string, type: string) {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  }

  document.querySelectorAll<HTMLButtonElement>(".download-wordmark").forEach((button) => {
    button.addEventListener("click", () => {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120" width="400" height="120"><text x="50%" y="68%" dominant-baseline="middle" text-anchor="middle" font-family="system-ui, Arial, sans-serif" font-weight="600" font-size="76" letter-spacing="-1.2" fill="#ffffff">faizan</text></svg>`;
      downloadFile("faizan_logo_white.svg", svg, "image/svg+xml");
    });
  });

</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  :global(body) {
    --background: #0d0d0f;
    --surface: #17171b;
    --surface-raised: #202026;
    --border: #2a2a31;
    --border-strong: #44444d;
    --text: #ecebe6;
    --muted: #9a99a3;
    --accent: #38bdf8;
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: var(--background);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  :global(body)::selection {
    background: var(--accent);
    color: var(--background);
  }

  * {
    box-sizing: border-box;
  }

  button {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--text);
    color: var(--background);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: rgb(13 13 15 / 92%);
    backdrop-filter: blur(14px);
  }

  .header-inner,
  .page-content,
  .site-footer {
    width: min(100% - 3rem, 960px);
    margin-inline: auto;
  }

  .header-inner {
    min-height: 3.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-transform: lowercase;
  }

  .primary-nav,
  .button,
  .section-kicker,
  .site-footer,
  .venue-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .primary-nav,
  .site-footer nav {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .primary-nav a,
  .site-footer a {
    transition: color 160ms ease;
  }

  .primary-nav a:hover,
  .site-footer a:hover {
    color: var(--text);
  }

  .button {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 0;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.3;
    transition: transform 160ms ease;
  }

  .button:active {
    transform: scale(0.98);
  }

  .button-primary {
    background: var(--accent);
    color: var(--background);
    box-shadow: 0 0 22px rgb(56 189 248 / 38%);
  }

  .button-muted {
    border-color: var(--text);
    background: transparent;
    color: var(--text);
  }

  .section-rule {
    border-bottom: 1px solid var(--border);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 5.5rem 0 4.5rem;
  }

  .eyebrow {
    margin-bottom: 0;
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-shadow: 0 0 12px rgb(56 189 248 / 35%);
  }

  h1 {
    margin: 0.75rem 0 1.1rem;
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-transform: lowercase;
  }

  .hero-subtitle {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .genres,
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .genres {
    margin: 1.35rem 0 1.75rem;
  }

  .genres span {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 0.8rem;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .genres span:hover {
    border-color: var(--accent);
    box-shadow: 0 0 12px rgb(56 189 248 / 25%);
  }

  .photo-frame {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-photo {
    aspect-ratio: 4 / 5;
    margin: 0;
    min-width: 0;
  }

  .content-section {
    padding-block: 4.375rem;
  }

  .section-heading {
    margin-bottom: 1.75rem;
  }

  .section-kicker {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2rem);
    line-height: 1.15;
  }

  .mix-grid,
  .venue-grid,
  .press-grid {
    display: grid;
    gap: 1.1rem;
  }

  .mix-grid {
    grid-template-columns: 1fr;
  }

  .mix-card,
  .venue-card,
  .press-card {
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }

  .mix-card {
    padding: 1.25rem;
  }

  .mix-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  .soundcloud-embed {
    width: 100%;
    height: 166px;
    display: block;
    border: 0;
  }

  .venue-grid {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .venue-card {
    padding: 1.35rem;
    border-top: 3px solid var(--accent);
  }

  .venue-card h3,
  .press-card-footer h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .venue-meta {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bio-copy {
    max-width: 680px;
    padding: 0 0 4.375rem;
  }

  .bio-copy p {
    margin: 0;
    color: #d0cfca;
    line-height: 1.7;
  }

  .also {
    margin: 1.75rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .also a {
    color: var(--accent);
  }

  .press-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .press-card {
    overflow: hidden;
  }

  .wordmark-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #25252c, #111);
  }

  .large-wordmark {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    text-transform: lowercase;
  }

  .press-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem;
  }

  .button-small {
    min-height: 2rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.63rem;
    white-space: nowrap;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-block: 1.875rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer nav {
    gap: 1.4rem;
  }

  @media (max-width: 720px) {
    .primary-nav {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .header-inner,
    .page-content,
    .site-footer {
      width: min(100% - 2rem, 960px);
    }

    .button {
      min-height: 2.6rem;
      padding: 0.65rem 1rem;
      font-size: 0.75rem;
    }

    .hero {
      padding-block: 3.5rem;
    }

    .hero-photo {
      width: min(100%, 24rem);
      justify-self: center;
    }

    .content-section {
      padding-block: 3rem;
    }

    .venue-grid,
    .press-grid {
      grid-template-columns: 1fr;
    }

    .site-footer {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
