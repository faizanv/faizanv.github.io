---
import Layout from "../layouts/Layout.astro";

const mixes = [
  {
    title: "Faizan Puts You On, Vol. 2",
    url: "https://soundcloud.com/faizanv/faizan-puts-you-on-vol-2",
  },
  {
    title: "Faizan Puts You On, Vol. 1 — UKG x Desi Bass x House Mix",
    url: "https://soundcloud.com/faizanv/faizan-puts-you-on-vol-1-ukg-x-desi-bass-x-house-mix",
  },
];

const soundcloudEmbedUrl = (url: string) =>
  `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%2360a5fa&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true`;

const venues = [
  {
    name: "Mood Ring",
    location: "Ridgewood, Brooklyn",
    role: "Peak Slot",
    description:
      "Peak-time UK bass, 2-step, and South Asian percussion for a packed late-night Ridgewood dancefloor.",
  },
  {
    name: "abunDANCE × Daytimers NYC",
    location: "Honey's / Bushwick, NY",
    role: "Curator / Resident",
    description:
      "Co-curated annual Brooklyn fundraiser uniting diaspora selectors and drawing 150+ dancers for local mutual aid.",
  },
  {
    name: "Eris Evolution",
    location: "Williamsburg, Brooklyn",
    role: "Direct Support",
    description:
      "High-velocity broken beat and sub-heavy club warm-up transitioning the main room into peak hours.",
  },
  {
    name: "Bossa Nova Civic Club & Jupiter Disco",
    location: "Bushwick, Brooklyn",
    role: "Guest Sets",
    description:
      "Intimate booth appearances blending dubwise textures, baile bounce, and unreleased percussive edits.",
  },
];

const bios = {
  short:
    "faizan is a Brooklyn-based DJ and selector weaving South Asian percussion through UK garage, broken beat, and sub-heavy global club rhythms—built for both patient warm-ups and high-velocity peak rooms.",
  full: [
    "faizan is a Brooklyn-based DJ and selector whose sets thread South Asian percussive traditions through UK garage, broken beat, and sub-heavy global club music. Equally comfortable building tension during early-room warm-ups or steering peak-time dancefloors, his selections prioritize rhythmic propulsion and cross-continental club edits.",
    "A fixture in Brooklyn’s underground circuit—with appearances at Mood Ring, Eris, Honey’s, and Bossa Nova Civic Club—faizan also co-curates abunDANCE, an annual fundraiser uniting diaspora selectors for local mutual aid.",
  ],
};

---

<Layout
  title="faizan — Electronic Press Kit"
  ogTitle="faizan — Electronic Press Kit"
  ogDescription="Press kit for faizan, a Brooklyn-based DJ and selector."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="toast-region" id="toast-region" aria-live="polite" aria-atomic="true"></div>

  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="/" aria-label="Faizan home">faizan</a>
      <span class="location-pill"><span class="status-dot"></span> EPK // BROOKLYN</span>
      <nav class="primary-nav" aria-label="Page sections">
        <a href="#bio">01. Bio &amp; Contact</a>
        <a href="#venues">02. Venues</a>
        <a href="#mixes">03. Mixes</a>
        <a href="#press">04. Press</a>
      </nav>
      <div class="header-actions">
        <a class="button button-muted soundcloud-link" href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">SoundCloud ↗</a>
        <a class="button button-primary" href="mailto:bookings@faizan.fun">Contact to Book <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </header>

  <main id="main" class="page-content">
    <section id="bio" class="section-rule">
      <div class="hero">
        <div class="hero-copy">
          <div>
            <p class="section-kicker">01 // Bio &amp; Contact</p>
            <div class="eyebrow location-label"><span>BROOKLYN, NY</span><span aria-hidden="true">/</span><span>DJ &amp; SELECTOR</span></div>
          </div>
          <div>
            <h1>faizan</h1>
            <p class="hero-subtitle">South Asian Percussive Club · UK Bass · Broken Beat &amp; Breaks</p>
          </div>
          <div class="quick-facts">
            <div class="fact-card">
              <span class="fact-label">Booth Format</span>
              <strong>CDJ-3000 / XDJ-XZ</strong>
              <span>Rekordbox USB &amp; vinyl-ready</span>
            </div>
            <a class="fact-card fact-link" href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">
              <span class="fact-label">Audio Archive <span aria-hidden="true">↗</span></span>
              <strong>SoundCloud Sets</strong>
              <span>soundcloud.com/faizanv</span>
            </a>
            <button class="fact-card copy-email" type="button" data-copy="bookings@faizan.fun">
              <span class="fact-label">Direct Booking <span aria-hidden="true">COPY</span></span>
              <strong>bookings@faizan.fun</strong>
              <span>Click to copy email</span>
            </button>
          </div>
        </div>

        <figure class="hero-photo photo-frame">
          <img src="/headshot.png" alt="Portrait of faizan" fetchpriority="high" />
          <figcaption><span>BROOKLYN // PRESS_01</span><a href="mailto:bookings@faizan.fun?subject=Press%20photo%20request">Request press photo ↗</a></figcaption>
        </figure>
      </div>

      <div class="content-section bio-section">
        <div class="bio-intro">
          <p class="section-kicker">Promoter Bio</p>
          <h2>Press &amp; Event Copy</h2>
          <div class="bio-controls" role="group" aria-label="Bio length">
            <button class="bio-mode is-active" type="button" data-bio-mode="short" aria-pressed="true">Event Listing</button>
            <button class="bio-mode" type="button" data-bio-mode="full" aria-pressed="false">Press Bio</button>
          </div>
          <button class="button button-muted copy-bio" type="button" data-copy-bio>Copy Bio ⧉</button>
        </div>
        <div class="bio-card">
          <div class="bio-card-header"><span id="bio-label">EVENT LISTING BIO</span><span>READY FOR RA / DICE</span></div>
          <div id="bio-content" class="bio-content">
            <p>{bios.short}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="venues" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 // Floor Experience</p>
          <h2>Selected Venues &amp; Past Gigs</h2>
        </div>
        <span class="section-note">BROOKLYN &amp; NYC ROOMS</span>
      </div>
      <div class="venue-grid">
        {venues.map((venue) => (
          <article class="venue-card">
            <div class="venue-heading">
              <div><h3>{venue.name}</h3><p>{venue.location}</p></div>
              <span class="venue-role">{venue.role}</span>
            </div>
            <p class="venue-description">{venue.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="mixes" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 // SoundCloud Archive</p>
          <h2>Mixes &amp; Live Sets</h2>
        </div>
        <a class="text-link" href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">Full SoundCloud Profile ↗</a>
      </div>
      <div class="mix-grid">
        {mixes.map((mix) => (
          <article class="mix-card">
            <h3>{mix.title}</h3>
            <iframe
              class="soundcloud-embed"
              src={soundcloudEmbedUrl(mix.url)}
              title={`SoundCloud player for ${mix.title}`}
              width="100%"
              height="300"
              scrolling="no"
              frameborder="no"
              allow="autoplay"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </article>
        ))}
      </div>
    </section>

    <section id="press" class="content-section section-rule">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 // Visuals</p>
          <h2>Press Photos &amp; Assets</h2>
        </div>
        <button class="text-link download-wordmark" type="button">Download Vector Wordmark (.SVG) ↓</button>
      </div>
      <div class="press-grid">
        <article class="press-card">
          <div class="press-image photo-frame">
            <img src="/headshot.png" alt="Portrait of faizan for press use" loading="lazy" />
            <span class="image-label">TRANSPARENT PNG</span>
          </div>
          <div class="press-card-footer">
            <div><h3>Portrait — Transparent PNG</h3><p>Headshot for flyers &amp; profiles</p></div>
            <a class="button button-small button-muted" href="mailto:bookings@faizan.fun?subject=Press%20photo%20request">Request</a>
          </div>
        </article>
        <article class="press-card wordmark-card">
          <div class="wordmark-preview bg-grid">
            <span class="image-label">TRANSPARENT VECTOR</span>
            <span class="large-wordmark">faizan</span>
            <span class="wordmark-caption">BROOKLYN // NYC</span>
          </div>
          <div class="press-card-footer">
            <div><h3>Flyer Logo Lockup</h3><p>Crisp SVG for poster artwork</p></div>
            <button class="button button-small button-muted download-wordmark" type="button">Download SVG</button>
          </div>
        </article>
      </div>
    </section>

  </main>

  <footer class="site-footer">
    <span><strong>faizan</strong> // BROOKLYN, NY</span>
    <nav aria-label="Social and booking links">
      <a href="https://soundcloud.com/faizanv" target="_blank" rel="noopener noreferrer">SOUNDCLOUD ↗</a>
      <a href="https://ra.co" target="_blank" rel="noopener noreferrer">RA ↗</a>
      <button type="button" data-copy="bookings@faizan.fun">BOOKINGS@FAIZAN.FUN</button>
    </nav>
  </footer>
</Layout>

<script>
  const bioCopy = {
    short: ["faizan is a Brooklyn-based DJ and selector weaving South Asian percussion through UK garage, broken beat, and sub-heavy global club rhythms—built for both patient warm-ups and high-velocity peak rooms."],
    full: [
      "faizan is a Brooklyn-based DJ and selector whose sets thread South Asian percussive traditions through UK garage, broken beat, and sub-heavy global club music. Equally comfortable building tension during early-room warm-ups or steering peak-time dancefloors, his selections prioritize rhythmic propulsion and cross-continental club edits.",
      "A fixture in Brooklyn’s underground circuit—with appearances at Mood Ring, Eris, Honey’s, and Bossa Nova Civic Club—faizan also co-curates abunDANCE, an annual fundraiser uniting diaspora selectors for local mutual aid.",
    ],
  };
  const toastRegion = document.querySelector<HTMLElement>("#toast-region");
  let toastTimer: number | undefined;

  function showToast(message: string) {
    if (!toastRegion) return;
    toastRegion.textContent = message;
    toastRegion.classList.add("is-visible");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toastRegion.classList.remove("is-visible");
    }, 2400);
  }

  async function copyText(text: string, message: string) {
    try {
      await navigator.clipboard.writeText(text);
      showToast(message);
    } catch (error) {
      showToast("Clipboard access unavailable. Please copy the text manually.");
      console.error("Could not copy text to clipboard.", error);
    }
  }

  function downloadFile(filename: string, content: string, type: string) {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", () => {
      const email = button.dataset.copy;
      if (email) void copyText(email, `Copied ${email}`);
    });
  });

  const bioContent = document.querySelector<HTMLElement>("#bio-content");
  const bioLabel = document.querySelector<HTMLElement>("#bio-label");
  document.querySelectorAll<HTMLButtonElement>("[data-bio-mode]").forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.bioMode;
      if ((mode !== "short" && mode !== "full") || !bioContent || !bioLabel) return;
      bioContent.replaceChildren(...bioCopy[mode].map((paragraph) => {
        const element = document.createElement("p");
        element.textContent = paragraph;
        return element;
      }));
      bioLabel.textContent = mode === "short" ? "EVENT LISTING BIO" : "PRESS BIO";
      document.querySelectorAll<HTMLButtonElement>("[data-bio-mode]").forEach((modeButton) => {
        const isActive = modeButton === button;
        modeButton.classList.toggle("is-active", isActive);
        modeButton.setAttribute("aria-pressed", String(isActive));
      });
    });
  });

  document.querySelector("[data-copy-bio]")?.addEventListener("click", () => {
    const activeMode = document.querySelector<HTMLButtonElement>(".bio-mode.is-active")?.dataset.bioMode;
    if (activeMode === "short" || activeMode === "full") {
      void copyText(bioCopy[activeMode].join("\n\n"), "Bio copied");
    }
  });

  document.querySelectorAll<HTMLButtonElement>(".download-wordmark").forEach((button) => {
    button.addEventListener("click", () => {
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120" width="400" height="120"><text x="50%" y="68%" dominant-baseline="middle" text-anchor="middle" font-family="system-ui, Arial, sans-serif" font-weight="600" font-size="76" letter-spacing="-1.2" fill="#ffffff">faizan</text></svg>`;
      downloadFile("faizan_logo_white.svg", svg, "image/svg+xml");
    });
  });

</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  :global(body) {
    --background: #0a0a0a;
    --surface: #111113;
    --surface-raised: #15171c;
    --border: #222328;
    --border-strong: #30333b;
    --text: #f4f6f9;
    --muted: #9aaec3;
    --blue: #60a5fa;
    --sky: #38bdf8;
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: var(--background);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(body)::selection {
    background: #2563eb;
    color: var(--text);
  }

  * {
    box-sizing: border-box;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--sky);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--text);
    color: var(--background);
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: rgb(10 10 10 / 92%);
    backdrop-filter: blur(14px);
  }

  .header-inner,
  .page-content,
  .site-footer {
    width: min(100% - 2rem, 1024px);
    margin-inline: auto;
  }

  .header-inner {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .wordmark,
  h1,
  .large-wordmark {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    letter-spacing: -0.035em;
  }

  .wordmark {
    font-size: 1.35rem;
    font-weight: 600;
    text-transform: lowercase;
  }

  .location-pill,
  .primary-nav,
  .button,
  .section-kicker,
  .section-note,
  .fact-label,
  .venue-heading > div > p,
  .venue-role,
  .bio-card-header,
  .press-card-footer > div > p,
  .wordmark-caption,
  .site-footer,
  figcaption,
  .image-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0.6rem rgb(56 189 248 / 55%);
  }

  .primary-nav,
  .header-actions,
  .site-footer nav {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 1.1rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: 0.64rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .primary-nav a,
  .site-footer a,
  .site-footer button,
  .text-link {
    transition: color 160ms ease;
  }

  .primary-nav a:hover,
  .site-footer a:hover,
  .site-footer button:hover,
  .text-link:hover {
    color: var(--text);
  }

  .header-actions {
    gap: 0.5rem;
  }

  .button {
    min-height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    cursor: pointer;
    font-size: 0.68rem;
    line-height: 1.3;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .button:active {
    transform: scale(0.98);
  }

  .button-primary {
    background: #2563eb;
    color: white;
  }

  .button-primary:hover {
    background: #3b82f6;
  }

  .button-muted {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .button-muted:hover {
    background: var(--surface-raised);
    border-color: #4b5563;
  }

  .page-content {
    position: relative;
  }

  .section-rule {
    border-bottom: 1px solid var(--border);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(220px, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.25rem);
    padding-block: 3.5rem;
    background-image:
      linear-gradient(to right, rgb(96 165 250 / 3.5%) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(96 165 250 / 3.5%) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
  }

  .eyebrow {
    width: fit-content;
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    background: var(--surface);
    color: var(--sky);
    font: 0.68rem ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.03em;
  }

  .location-label span:nth-child(2) {
    color: var(--border-strong);
  }

  .location-label span:last-child {
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 11vw, 7.5rem);
    font-weight: 600;
    line-height: 0.95;
    text-transform: lowercase;
  }

  .hero-subtitle {
    max-width: 39rem;
    margin: 0.8rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .fact-card {
    min-width: 0;
    min-height: 6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--surface);
    text-align: left;
  }

  button.fact-card {
    cursor: pointer;
  }

  .fact-link:hover,
  .copy-email:hover {
    border-color: var(--blue);
    background: var(--surface-raised);
  }

  .fact-label,
  .fact-card > span:last-child {
    color: var(--muted);
    font-size: 0.62rem;
  }

  .fact-label {
    width: 100%;
    display: flex;
    justify-content: space-between;
    color: var(--blue);
    font-size: 0.59rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fact-card strong {
    max-width: 100%;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .photo-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: grayscale(100%) contrast(118%) brightness(92%);
    transition: filter 400ms ease, transform 400ms ease;
  }

  .photo-frame:hover img {
    filter: grayscale(35%) contrast(112%) brightness(98%);
    transform: scale(1.02);
  }

  .hero-photo {
    aspect-ratio: 4 / 4.6;
    margin: 0;
    border-radius: 0.8rem;
  }

  .hero-photo::after {
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgb(10 10 10 / 85%));
    content: "";
    pointer-events: none;
  }

  figcaption {
    position: absolute;
    z-index: 1;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.6rem;
  }

  figcaption a {
    color: var(--text);
    white-space: nowrap;
  }

  .content-section {
    padding-block: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-kicker {
    margin: 0 0 0.35rem;
    color: var(--blue);
    font-size: 0.67rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .text-link {
    border: 0;
    background: transparent;
    color: var(--sky);
    cursor: pointer;
    font: 0.68rem ui-monospace, SFMono-Regular, Menlo, monospace;
    text-align: left;
  }

  .section-note {
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .mix-grid,
  .venue-grid,
